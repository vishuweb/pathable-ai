# Meta Model API key from https://dev.meta.ai
MODEL_API_KEY=

# Optional overrides
# META_API_BASE_URL=https://api.meta.ai/v1
# ANALYSIS_MODEL=muse-spark-1.3
# SEGMENTATION_MODEL=sam-3.1
# TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
# DATA_DIR=./data   (saved reports, review queue drafts)

# Public deployment (e.g. Vercel)
# BLOB_READ_WRITE_TOKEN=     set automatically when a Vercel Blob store is connected; switches storage from disk to Blob
# BLOB_ACCESS=private        match the store's access setting (private or public)
# OWNER_KEY=                 long random secret; reserves batch analysis and the review queue for you (sign in at /owner)
# ANALYZE_LIMIT_PER_HOUR=30  AI requests per visitor per hour (default 30 when OWNER_KEY is set, otherwise unlimited)
# AI_DAILY_LIMIT=300         AI requests per day for everyone together (default 300 on a deployment, otherwise unlimited)
# AI_PAUSED=1                stop all AI calls (e.g. after the judging period)
